# ============ REQUIRED ============
DATABASE_URL=postgresql://reliva:changeme@localhost:5432/reliva
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32

# ============ DOCKER COMPOSE DB CREDENTIALS (LOCAL/DEV FALLBACK) ============
# Production target is Vercel + managed PostgreSQL. Docker remains a local/dev fallback.
POSTGRES_USER=reliva
POSTGRES_PASSWORD=changeme
POSTGRES_DB=reliva
# Override only when intentionally testing a container image.
# CRAWLSEO_IMAGE=ghcr.io/mmgrafisk/crawlseo:latest

# ============ GOOGLE EMPLOYEE LOGIN ============
# Employee sign-in requests only: openid email profile.
# Search Console access is NOT granted by login; it is connected separately in Reliva.
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here

# ============ GOOGLE SEARCH CONSOLE READ-ONLY CONNECTION ============
# Dedicated integration flow requests only:
# https://www.googleapis.com/auth/webmasters.readonly
# Add the callback URI to the same Google OAuth web client.
# For production use a stable authorized URI; local dev can derive it from the request origin.
# GOOGLE_GSC_REDIRECT_URI=https://app.example.com/api/connections/google-search-console/callback

# Optional: PageSpeed Insights API key (higher quota for Core Web Vitals)
# GOOGLE_PAGESPEED_KEY=

# ============ AUTH.JS / APP URL ============
# Production: use the stable Vercel/custom Reliva URL.
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# AUTH_SECRET works as an Auth.js v5 alias if preferred.
# AUTH_SECRET=

# ============ OPTIONAL: Scheduling / worker layer ============
# Background jobs will sit behind Reliva's job abstraction. These values remain fallback/local examples.
# CRAWL_SCHEDULE=0 0 * * 0
# GSC_SYNC_SCHEDULE=0 2 * * *
# VITALS_SCHEDULE=0 3 * * 0
# REDIS_URL=redis://localhost:6379

# ============ EMPLOYEE INVITATION EMAIL (NOT WIRED YET) ============
# Reliva is invite-only; there is no public registration switch.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=reliva@example.com

# ============ OPTIONAL: Alert providers ============
# TELEGRAM_BOT_TOKEN=
# SLACK_WEBHOOK_URL=

# ============ NODE ENVIRONMENT ============
# NODE_ENV=development
