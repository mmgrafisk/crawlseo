generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH & ORGANIZATIONS ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  locale        String    @default("da")
  timeZone      String    @default("Europe/Copenhagen")
  googleTokens  Json?     // Encrypted GSC OAuth tokens
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  sites           Site[]       // transitional direct ownership; organizationId becomes canonical after migration
  alerts          Alert[]
  apiKeys         ApiKey[]
  memberships     Membership[]
  invitationsSent Invitation[]  @relation("InvitationInviter")
  createdTasks    Task[]        @relation("TaskCreator")
  assignedTasks   Task[]        @relation("TaskAssignee")
  auditLogs       AuditLog[]
  notifications   Notification[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  invitations  Invitation[]
  sites        Site[]
  tasks        Task[]
  auditLogs    AuditLog[]
  notifications Notification[]
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(EMPLOYEE)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole @default(EMPLOYEE)
  token          String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy     User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@index([email, acceptedAt])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope               String?
  id_token            String?
  session_state       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ API KEYS (BYOK) ============

model ApiKey {
  id                String   @id @default(cuid())
  userId            String
  provider          String   // "dataforseo" (login+password) | "google_pagespeed" (single key)
  encryptedLogin    String?  // null for single-key providers like google_pagespeed
  encryptedPassword String   // holds the API key itself for single-key providers
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// ============ SITES ============

model Site {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?
  domain         String   // e.g. "brandson.digital"
  gscProperty    String?  // e.g. "sc-domain:brandson.digital"
  marketCode     String?
  contentLocale  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  keywords      Keyword[]
  pages         Page[]
  crawls        Crawl[]
  vitals        VitalsReport[]
  alerts        Alert[]
  savedKeywords SavedKeyword[]
  rankSnapshots RankSnapshot[]
  tasks         Task[]

  @@unique([userId, domain])
  @@index([organizationId, domain])
}

// ============ GSC DATA ============

model Keyword {
  id          String   @id @default(cuid())
  siteId      String
  query       String
  date        DateTime
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  page        String?
  device      String?
  country     String?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query, date])
  @@index([siteId, date])
  @@index([siteId, query, date])
}

model Page {
  id          String   @id @default(cuid())
  siteId      String
  url         String
  date        DateTime
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, url, date])
  @@index([siteId, date])
  @@index([siteId, url, date])
}

// ============ SAVED KEYWORDS ============

model SavedKeyword {
  id        String   @id @default(cuid())
  siteId    String
  query     String
  notes     String?
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query])
  @@index([siteId])
}

// ============ RANK TRACKING ============

model RankSnapshot {
  id          String   @id @default(cuid())
  siteId      String
  query       String
  position    Float
  clicks      Int      @default(0)
  impressions Int      @default(0)
  page        String?
  date        DateTime

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query, date])
  @@index([siteId, date])
  @@index([siteId, query, date])
}

// ============ CRAWLER ============

model Crawl {
  id              String      @id @default(cuid())
  siteId          String
  status          CrawlStatus @default(PENDING)
  startedAt       DateTime?
  finishedAt      DateTime?
  pagesFound      Int         @default(0)
  issuesFound     Int         @default(0)
  healthScore     Int?
  maxPages        Int         @default(200)
  discoveredUrls  Int         @default(0)
  attemptedUrls   Int         @default(0)
  fetchedUrls     Int         @default(0)
  failedUrls      Int         @default(0)
  excludedUrls    Int         @default(0)
  sitemapUrls     Int         @default(0)
  coveragePercent Float?
  coverageReason  String?

  site       Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  issues     CrawlIssue[]
  auditPages AuditPage[]
  auditLinks AuditLink[]

  @@index([siteId, startedAt])
}

enum CrawlStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

// ============ AUDIT PAGE DATA ============

model AuditPage {
  id                 String  @id @default(cuid())
  crawlId            String
  url                String
  statusCode         Int
  redirectUrl        String?
  title              String?
  description        String?
  canonical          String?
  robotsMeta         String?
  h1Count            Int     @default(0)
  h1s                Json?
  wordCount          Int     @default(0)
  imageCount         Int     @default(0)
  imagesMissingAlt   Int     @default(0)
  internalLinks      Int     @default(0)
  externalLinks      Int     @default(0)
  hasSchema          Boolean @default(false)
  hreflangTags       Json?
  contentScore       Int     @default(0)
  contentHash        String?
  responseTimeMs     Int     @default(0)
  byteSize           Int     @default(0)
  indexable          Boolean @default(true)

  crawl Crawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId])
  @@index([crawlId, url])
}

// ============ AUDIT LINK GRAPH ============

model AuditLink {
  id          String  @id @default(cuid())
  crawlId     String
  sourceUrl   String
  targetUrl   String
  anchorText  String?
  isInternal  Boolean @default(true)
  isNofollow  Boolean @default(false)
  statusCode  Int?

  crawl Crawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId])
  @@index([crawlId, sourceUrl])
}

model CrawlIssue {
  id       String        @id @default(cuid())
  crawlId  String
  url      String
  type     IssueType
  severity IssueSeverity
  message  String
  details  Json?

  crawl Crawl  @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([crawlId, type])
}

enum IssueType {
  BROKEN_LINK
  REDIRECT
  MISSING_TITLE
  MISSING_DESCRIPTION
  DUPLICATE_TITLE
  DUPLICATE_DESCRIPTION
  MISSING_H1
  MULTIPLE_H1
  MISSING_ALT
  MISSING_CANONICAL
  MISSING_ROBOTS
  MISSING_SITEMAP
  MISSING_SCHEMA
  SLOW_PAGE
  MIXED_CONTENT
  LARGE_PAGE
  ORPHAN_PAGE
  THIN_CONTENT
  CRAWL_SUMMARY
}

enum IssueSeverity {
  CRITICAL
  WARNING
  INFO
}

// ============ TASKS / VERIFICATION ============

model Task {
  id               String       @id @default(cuid())
  organizationId   String
  siteId           String?
  findingId        String?
  title            String
  description      String?
  status           TaskStatus   @default(OPEN)
  priority         TaskPriority @default(MEDIUM)
  createdById      String
  assignedToId     String?
  completedAt      DateTime?
  verifiedAt       DateTime?
  verificationNote String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  finding      CrawlIssue?  @relation(fields: [findingId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([siteId, status])
  @@index([assignedToId, status])
  @@index([findingId])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  IMPLEMENTED_PENDING_VERIFICATION
  VERIFIED
  IGNORED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============ CORE WEB VITALS ============

model VitalsReport {
  id        String   @id @default(cuid())
  siteId    String
  url       String
  date      DateTime @default(now())
  device    String
  lcp       Float?
  fid       Float?
  cls       Float?
  inp       Float?
  perfScore Int?
  speedIndex Float?
  ttfb      Float?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, date])
  @@index([siteId, url, date])
}

// ============ ALERTS ============

model Alert {
  id        String       @id @default(cuid())
  userId    String
  siteId    String
  type      AlertType
  channel   AlertChannel
  config    Json
  enabled   Boolean      @default(true)
  lastFired DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

enum AlertType {
  TRAFFIC_DROP
  POSITION_CHANGE
  NEW_404
  VITALS_DEGRADED
  CRAWL_ISSUES
}

enum AlertChannel {
  EMAIL
  TELEGRAM
  WEBHOOK
  SLACK
}

// ============ AUDIT LOG / NOTIFICATIONS ============

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([organizationId, createdAt])
}
